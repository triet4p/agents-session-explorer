+			if (request.tracking !== undefined && request.signal?.aborted !== true) {
+				const journal = request.session.sessionManager;
+				const parentSessionId = journal?.getSessionId?.();
+				if (!journal || !parentSessionId || !request.session.getSessionFile() || !baseOptions.sessionFile) {
+					throw new Error("Tracked task dispatch requires file-backed parent and child sessions");
+				}
