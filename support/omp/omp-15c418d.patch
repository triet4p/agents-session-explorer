+				journal.appendCustomEntry("task_dispatch_v1", {
+					dispatch_id: dispatchId,
+					parent_tool_call_id: request.parentToolCallId,
+					spawn_index: request.index ?? 0,
+					parent_session_id: parentSessionId,
+					project_id,
+					task_id,
+					attempt_id,
+				});
+				await journal.ensureOnDisk();
+				await journal.flush();
+				baseOptions.dispatchId = dispatchId;
+			}
 			if (!isolationContext) {
 				result = await runSubprocess(baseOptions);
 				onSubprocessResult?.(result);
