+interface DispatchRecord {
+	dispatch_id: string;
+	parent_tool_call_id?: string;
+	spawn_index: number;
+	parent_session_id: string;
+	project_id: string;
+	task_id: string;
+	attempt_id: string;
+}
+
+interface DispatchChildLink {
+	dispatch_id: string;
+	session_id: string;
+}
+
+/** Validate a persisted `task_dispatch_v1` payload before reading it as evidence. */
+function isDispatchRecord(value: unknown): value is DispatchRecord {
+	return (
+		isRecord(value) &&
+		typeof value.dispatch_id === "string" &&
+		(value.parent_tool_call_id === undefined || typeof value.parent_tool_call_id === "string") &&
+		typeof value.spawn_index === "number" &&
+		typeof value.parent_session_id === "string" &&
+		typeof value.project_id === "string" &&
+		typeof value.task_id === "string" &&
+		typeof value.attempt_id === "string"
+	);
+}
+
+/** Validate a persisted `task_dispatch_child_v1` payload before reading it as evidence. */
+function isDispatchChildLink(value: unknown): value is DispatchChildLink {
+	return isRecord(value) && typeof value.dispatch_id === "string" && typeof value.session_id === "string";
+}
+
+/** Read a durable session journal through the production loader (title slot included). */
+async function persistedSessionEntries(file: string) {
+	const { entries, invalidHeader } = parseSessionContent(await Bun.file(file).text());
+	if (invalidHeader) throw new Error(`Invalid session header: ${file}`);
+	return entries;
+}
